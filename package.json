{
  "name": "quick-studio",
  "version": "0.0.1",
  "type": "module",
  "description": "Lightweight local-first DB manager (Postgres + MySQL) — walking skeleton",
  "bin": {
    "quick-studio": "bin/quick-studio.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun scripts/build-ui.ts && bun scripts/build-sandbox.ts && bun scripts/build-snapshot.ts && bun scripts/build-live-report.ts",
    "build:binary": "bun run build && bun build --compile bin/quick-studio.ts --outfile dist/quick-studio",
    "dev": "bun run build && bun run bin/quick-studio.ts",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@dagrejs/dagre": "^3.0.0",
    "@napi-rs/keyring": "1.3.0",
    "@observablehq/plot": "0.6.17",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.22",
    "micromark": "^4.0.2",
    "mysql2": "3.22.5",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^3",
    "recharts": "^3.9.2",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "bun-plugin-tailwind": "^0.1.2",
    "typescript": "^5.7.0"
  }
}
