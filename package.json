{
  "name": "quick-studio",
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight, local-first database manager (Postgres + MySQL).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joajo13/quick-studio.git"
  },
  "bin": {
    "quick-studio": "bin/quick-studio.cjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun scripts/build-ui.ts && bun scripts/build-sandbox.ts && bun scripts/build-snapshot.ts && bun scripts/build-live-report.ts && bun scripts/build-version.ts",
    "build:binary": "bun run build && bun build --compile bin/quick-studio.ts --outfile dist/quick-studio",
    "dev": "bun run build && bun run bin/quick-studio.ts",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dagrejs/dagre": "^3.0.0",
    "@lezer/highlight": "^1.2.3",
    "@napi-rs/keyring": "1.3.0",
    "@observablehq/plot": "0.6.17",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "micromark": "^4.0.2",
    "mysql2": "3.22.5",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^3",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "bun-plugin-tailwind": "^0.1.2",
    "typescript": "^5.7.0"
  }
}
